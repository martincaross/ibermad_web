# ==============================================================================
# IBERMAD - Configuración de Servidor Apache (.htaccess)
# Seguridad, Redirecciones Canónicas, HTTPS y Optimización de Rendimiento
# ==============================================================================

# 1. SEGURIDAD: Prevenir navegación de directorios y proteger archivos sensibles
Options -Indexes

<FilesMatch "^\.(htaccess|htpasswd|ini|phps|fla|psd|log|sh|git|env)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# 2. CABECERAS DE SEGURIDAD HTTP
<IfModule mod_headers.c>
    # Evitar ataques de clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # Prevenir ataques MIME-sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Protección contra XSS
    Header always set X-XSS-Protection "1; mode=block"

    # Política de Referrer
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Limitar acceso a hardware y APIs sensibles
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
</IfModule>

# 3. REGLAS DE REESCRITURA: HTTPS Y CANONICALIZACIÓN SIN BUCLE DE PROXY
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirigir www.ibermad.es -> https://ibermad.es
    RewriteCond %{HTTP_HOST} ^www\.ibermad\.es$ [NC]
    RewriteRule ^(.*)$ https://ibermad.es/$1 [R=301,L]

    # Forzar HTTPS compatible con el proxy de Piensa Solutions (sin bucles)
    RewriteCond %{HTTPS} !on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^(.*)$ https://ibermad.es/$1 [R=301,L]
</IfModule>

# 4. COMPRESIÓN GZIP / DEFLATE
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# 5. CACHÉ DEL NAVEGADOR PARA RECURSOS ESTÁTICOS
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    ExpiresByType text/html "access plus 1 hour"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
</IfModule>
